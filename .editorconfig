root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
indent_style = space
max_line_length = 140
# Kotlin coding conventions (kotlinlang.org), the style IntelliJ applies with kotlin.code.style=official.
ktlint_code_style = intellij_idea
# Test names in backticks read as sentences.
ktlint_function_naming_ignore_when_annotated_with = Test
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[Makefile]
indent_style = tab

[*.{xml,properties,md}]
indent_size = 4
